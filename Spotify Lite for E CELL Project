<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Pulse Player</title>
<style>
/* ---------- Design tokens ---------- */
:root {
  --bg: #0e0f11; --panel: #181a1e; --panel-hover: #22252a;
  --text: #f2f3f5; --muted: #9aa0a8; --accent: #1ed760; --radius: 16px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  min-height: 100vh;
  background: radial-gradient(circle at 20% 0%, #1c2a22 0%, var(--bg) 55%);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  display: grid; grid-template-columns: minmax(0, 920px); justify-content: center;
  align-content: start; gap: 20px; padding: 24px 16px;
}
code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.85em; background: var(--panel-hover); padding: 1px 5px; border-radius: 4px; }

/* ---------- Header / footer ---------- */
.site-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; }
.brand { font-weight: 700; font-size: 1.25rem; color: var(--accent); }
.tagline, .site-footer { color: var(--muted); font-size: 0.9rem; }
.site-footer { text-align: center; padding: 8px 0 16px; }

/* ---------- Layout ---------- */
.app { display: grid; gap: 20px; }
@media (min-width: 800px) { .app { grid-template-columns: 360px 1fr; align-items: start; } }
.player, .playlist-panel { background: var(--panel); border-radius: var(--radius); padding: 24px; }

/* ---------- Now playing ---------- */
.cover { aspect-ratio: 1; border-radius: 12px; box-shadow: 0 16px 40px rgba(0,0,0,.45); margin-bottom: 20px; transition: background .4s; }
.track-count { font-size: .8rem; color: var(--accent); margin-bottom: 6px; }
.info h1 { font-size: 1.4rem; line-height: 1.2; }
.info p { color: var(--muted); }
#artist { margin-top: 4px; }
.progress-row, .volume-row { display: flex; align-items: center; gap: 10px; margin-top: 20px; }
.volume-row { margin-top: 12px; }
.time { font-size: .8rem; color: var(--muted); font-variant-numeric: tabular-nums; min-width: 36px; }
.time:last-child { text-align: right; }

/* ---------- Controls ---------- */
.controls { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 16px; }
.btn { width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: var(--text); cursor: pointer; display: grid; place-items: center; transition: transform .15s, background .15s; }
.btn:hover { background: var(--panel-hover); transform: scale(1.08); }
.btn svg { width: 24px; height: 24px; fill: currentColor; }
.btn-play { width: 60px; height: 60px; background: var(--accent); color: #000; }
.btn-play:hover { background: var(--accent); transform: scale(1.1); }
.btn-play svg { width: 28px; height: 28px; }
.vol-icon { width: 20px; height: 20px; fill: var(--muted); flex-shrink: 0; }
.loading { margin-top: 12px; font-size: .85rem; color: var(--accent); }
.status { min-height: 1.2em; margin-top: 12px; font-size: .85rem; color: #ff8a8a; }
.hint { margin-top: 8px; font-size: .8rem; color: var(--muted); }

/* ---------- Sliders (--fill is set from JS) ---------- */
.slider { --fill: 0%; flex: 1; height: 4px; appearance: none; -webkit-appearance: none; border-radius: 2px; cursor: pointer;
  background: linear-gradient(to right, var(--accent) var(--fill), #3a3d44 var(--fill)); }
.slider::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--text); }
.slider::-moz-range-thumb { width: 14px; height: 14px; border: 0; border-radius: 50%; background: var(--text); }

/* ---------- Playlist ---------- */
.panel-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
.panel-head h2, .about h2 { font-size: 1rem; color: var(--muted); font-weight: 600; }
.panel-meta { font-size: .85rem; color: var(--muted); }
.playlist { list-style: none; display: grid; gap: 4px; }
.track { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border: 0; border-radius: 10px; width: 100%; background: transparent; color: inherit; text-align: left; font: inherit; cursor: pointer; }
.track:hover { background: var(--panel-hover); }
.track-art { width: 44px; height: 44px; border-radius: 8px; flex-shrink: 0; }
.track-text { flex: 1; min-width: 0; }
.track-title { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.track-artist { font-size: .85rem; color: var(--muted); }
.track.active { background: var(--panel-hover); box-shadow: inset 3px 0 0 var(--accent); }  /* current track */
.track.active .track-title { color: var(--accent); }

/* ---------- Add local music ---------- */
.add-btn { margin-top: 14px; width: 100%; padding: 12px; border: 1px dashed #4a4e56; border-radius: 10px; background: transparent; color: var(--text); font: inherit; cursor: pointer; }
.add-btn:hover { border-color: var(--accent); color: var(--accent); }
.panel-note { margin-top: 12px; font-size: .85rem; color: var(--muted); line-height: 1.5; }

/* ---------- About ---------- */
.about { background: var(--panel); border-radius: var(--radius); padding: 24px; }
.about h2 { margin-bottom: 14px; }
.about-list { display: grid; gap: 14px; }
@media (min-width: 800px) { .about { grid-column: 1 / -1; } .about-list { grid-template-columns: repeat(2, 1fr); gap: 18px 28px; } }
.about dt { font-weight: 600; margin-bottom: 4px; }
.about dd { color: var(--muted); font-size: .9rem; line-height: 1.5; max-width: 60ch; }

/* ---------- Focus + reduced motion ---------- */
button:focus-visible, .slider:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>
  <header class="site-header">
    <div class="brand">Pulse Player</div>
    <p class="tagline">A browser music player built with the HTML5 Audio API.</p>
  </header>

  <main class="app">
    <!-- Left: now playing + controls -->
    <section class="player" aria-label="Music player">
      <div class="cover" id="cover" aria-hidden="true"></div>

      <div class="info">
        <p id="trackCount" class="track-count">Track 1 of 3</p>
        <h1 id="title">Choose a song</h1>
        <p id="artist">Pulse Player</p>
      </div>

      <div class="progress-row">
        <span id="currentTime" class="time">0:00</span>
        <input type="range" id="progress" class="slider" min="0" max="100" step="0.1" value="0" aria-label="Seek" />
        <span id="duration" class="time">0:00</span>
      </div>

      <div class="controls">
        <button id="prevBtn" class="btn" aria-label="Previous track" title="Previous (P)">
          <svg viewBox="0 0 24 24"><path d="M6 5h2v14H6zM20 5v14L9.5 12z"/></svg>
        </button>
        <button id="playBtn" class="btn btn-play" aria-label="Play" title="Play / Pause (Space)">
          <svg id="playIcon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          <svg id="pauseIcon" viewBox="0 0 24 24" hidden><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
        </button>
        <button id="nextBtn" class="btn" aria-label="Next track" title="Next (N)">
          <svg viewBox="0 0 24 24"><path d="M16 5h2v14h-2zM4 5l10.5 7L4 19z"/></svg>
        </button>
      </div>

      <div class="volume-row">
        <svg class="vol-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9zM16.5 12a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/></svg>
        <input type="range" id="volume" class="slider" min="0" max="1" step="0.01" value="0.7" aria-label="Volume" />
        <span id="volumeValue" class="time">70%</span>
      </div>

      <p id="loading" class="loading" role="status" hidden>Buffering...</p>
      <p id="status" class="status" role="alert"></p>
      <p class="hint">Shortcuts: Space to play or pause, N for next, P for previous.</p>
    </section>

    <!-- Right: playlist (filled in by JavaScript) -->
    <section class="playlist-panel" aria-label="Playlist">
      <div class="panel-head">
        <h2>Your music</h2>
        <span id="playlistCount" class="panel-meta">3 tracks</span>
      </div>
      <ul id="playlist" class="playlist"></ul>

      <!-- Hidden file picker, opened by the button below -->
      <input type="file" id="fileInput" accept="audio/*" multiple hidden />
      <button id="addBtn" class="add-btn" type="button">+ Add music from your computer</button>
      <p class="panel-note">The three tracks above load from the <code>audio</code> folder next to this file. Use the button to add more songs for this session.</p>
    </section>

    <section class="about" aria-labelledby="aboutTitle">
      <h2 id="aboutTitle">How it works</h2>
      <dl class="about-list">
        <div><dt>Playback controls</dt><dd>Play, pause, previous and next buttons plus a volume slider, all driven by one <code>&lt;audio&gt;</code> element.</dd></div>
        <div><dt>Seek bar</dt><dd>Shows elapsed time against total duration. Drag it to jump anywhere in the song.</dd></div>
        <div><dt>Playlist state</dt><dd>The current track is highlighted, and clicking a track loads and plays it.</dd></div>
        <div><dt>Media lifecycle</dt><dd>Listens for <code>loadedmetadata</code>, <code>timeupdate</code>, <code>waiting</code>, <code>canplay</code>, <code>ended</code> and <code>error</code> to keep the screen in sync with the audio.</dd></div>
        <div><dt>Listener management</dt><dd>Listeners are attached once at startup and the playlist uses one delegated click handler, so fast track changes never stack up duplicate handlers.</dd></div>
      </dl>
    </section>
  </main>

  <footer class="site-footer">
    <p>Replace the file names in the <code>tracks</code> list inside the script to use your own music.</p>
  </footer>

  <audio id="audio" preload="metadata"></audio>

<script>
// ===== 1. DATA =====
// Put your 3 mp3 files in an "audio" folder next to this file and
// name them like below (or change the "src" values and titles).
const tracks = [
  { title: "Alone",   artist: "Local track", src: "Alone.mp3",     colors: ["#1ed760", "#0b3d2e"] },
  { title: "Co2",     artist: "Local track", src: "Co2%20(1).mp3", colors: ["#ff6b6b", "#4a1942"] },
  { title: "Perfect", artist: "Ed Sheeran",  src: "perfect.mp3",   colors: ["#4facfe", "#0f2a5c"] },
];

// ===== 2. GRAB ELEMENTS =====
const $ = (id) => document.getElementById(id);
const audio = $("audio"), playBtn = $("playBtn"), prevBtn = $("prevBtn"), nextBtn = $("nextBtn");
const playIcon = $("playIcon"), pauseIcon = $("pauseIcon");
const progress = $("progress"), volume = $("volume");
const currentTime = $("currentTime"), duration = $("duration");
const titleEl = $("title"), artistEl = $("artist"), coverEl = $("cover");
const playlistEl = $("playlist"), statusEl = $("status"), loadingEl = $("loading");
const trackCount = $("trackCount"), volumeValue = $("volumeValue"), playlistCount = $("playlistCount");
const addBtn = $("addBtn"), fileInput = $("fileInput");

// ===== 3. STATE =====
let currentIndex = 0;
let isSeeking = false; // true while the user drags the progress bar

// ===== 4. HELPERS =====
function formatTime(seconds) {
  if (!Number.isFinite(seconds)) return "0:00"; // duration is NaN until metadata loads
  const m = Math.floor(seconds / 60);
  const s = Math.floor(seconds % 60);
  return `${m}:${String(s).padStart(2, "0")}`;
}
function gradient(track) { return `linear-gradient(135deg, ${track.colors[0]}, ${track.colors[1]})`; }
function setFill(slider) { // colors the left part of a slider
  const percent = ((slider.value - slider.min) / (slider.max - slider.min)) * 100;
  slider.style.setProperty("--fill", percent + "%");
}

// ===== 5. RENDERING =====
function renderPlaylist() {
  playlistEl.innerHTML = "";
  tracks.forEach((track, index) => {
    const li = document.createElement("li");
    const button = document.createElement("button");
    button.className = "track";
    button.dataset.index = index;
    button.innerHTML = `
      <div class="track-art" style="background:${gradient(track)}"></div>
      <div class="track-text"><div class="track-title"></div><div class="track-artist"></div></div>`;
    // textContent (not innerHTML) so file names can't inject HTML
    button.querySelector(".track-title").textContent = track.title;
    button.querySelector(".track-artist").textContent = track.artist;
    li.appendChild(button);
    playlistEl.appendChild(li);
  });
  playlistCount.textContent = `${tracks.length} track${tracks.length === 1 ? "" : "s"}`;
  highlightCurrentTrack();
}
function highlightCurrentTrack() {
  document.querySelectorAll(".track").forEach((el, i) => el.classList.toggle("active", i === currentIndex));
}
function updatePlayButton() {
  const playing = !audio.paused;
  playIcon.hidden = playing;
  pauseIcon.hidden = !playing;
  playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
}

// ===== 6. PLAYER ACTIONS =====
function loadTrack(index) {
  currentIndex = index;
  const track = tracks[index];
  audio.src = track.src;
  titleEl.textContent = track.title;
  artistEl.textContent = track.artist;
  coverEl.style.background = gradient(track);
  document.title = `${track.title} - Pulse Player`;
  statusEl.textContent = "";
  loadingEl.hidden = false; // hidden again on "canplay"
  trackCount.textContent = `Track ${index + 1} of ${tracks.length}`;
  progress.value = 0; setFill(progress);
  currentTime.textContent = "0:00";
  duration.textContent = "0:00";
  highlightCurrentTrack();
}
function playTrack() {
  // play() returns a Promise; browsers can reject it (e.g. autoplay rules)
  audio.play().catch((err) => console.warn("Playback blocked:", err));
}
function togglePlay() { audio.paused ? playTrack() : audio.pause(); }
function nextTrack() { loadTrack((currentIndex + 1) % tracks.length); playTrack(); } // wraps to first
function prevTrack() {
  // Past 3 seconds? Restart the song instead of going back
  if (audio.currentTime > 3) { audio.currentTime = 0; return; }
  loadTrack((currentIndex - 1 + tracks.length) % tracks.length);
  playTrack();
}

// ===== 7. AUDIO EVENT HANDLERS =====
function onMetadataLoaded() { duration.textContent = formatTime(audio.duration); }
function onTimeUpdate() {
  if (isSeeking) return; // don't fight the user's drag
  currentTime.textContent = formatTime(audio.currentTime);
  progress.value = (audio.currentTime / audio.duration) * 100 || 0;
  setFill(progress);
}
function onEnded() { nextTrack(); }
function onWaiting() { loadingEl.hidden = false; }
function onCanPlay() { loadingEl.hidden = true; }
function onError() {
  loadingEl.hidden = true;
  statusEl.textContent = `Couldn't load "${tracks[currentIndex].src}". Check that the file exists in the audio folder.`;
}

// ===== 8. USER INPUT HANDLERS =====
function onProgressInput() { // while dragging: labels only
  isSeeking = true;
  currentTime.textContent = formatTime((progress.value / 100) * audio.duration);
  setFill(progress);
}
function onProgressChange() { // on release: actually seek
  if (Number.isFinite(audio.duration)) audio.currentTime = (progress.value / 100) * audio.duration;
  isSeeking = false;
}
function onVolumeInput() {
  audio.volume = volume.value;
  volumeValue.textContent = Math.round(volume.value * 100) + "%";
  setFill(volume);
}
function onPlaylistClick(event) { // event delegation: one listener for every song
  const button = event.target.closest(".track");
  if (!button) return;
  loadTrack(Number(button.dataset.index));
  playTrack();
}
function onKeyDown(event) {
  if (event.target.closest("button, input")) return; // let focused controls behave normally
  if (event.code === "Space") { event.preventDefault(); togglePlay(); }
  if (event.key === "n" || event.key === "N") nextTrack();
  if (event.key === "p" || event.key === "P") prevTrack();
}
function onFilesChosen() { // add songs picked from the user's computer
  const hues = [40, 280, 170, 340, 210, 90];
  Array.from(fileInput.files).forEach((file) => {
    const hue = hues[tracks.length % hues.length];
    tracks.push({
      title: file.name.replace(/\.[^.]+$/, ""),
      artist: "Local file",
      src: URL.createObjectURL(file), // temporary URL for this browser session
      colors: [`hsl(${hue} 80% 55%)`, `hsl(${hue} 60% 15%)`],
    });
  });
  fileInput.value = ""; // allows picking the same file again
  renderPlaylist();
  trackCount.textContent = `Track ${currentIndex + 1} of ${tracks.length}`;
}

// ===== 9. WIRE EVERYTHING UP (all listeners in one place) =====
function init() {
  renderPlaylist();

  playBtn.addEventListener("click", togglePlay);
  nextBtn.addEventListener("click", nextTrack);
  prevBtn.addEventListener("click", prevTrack);

  progress.addEventListener("input", onProgressInput);
  progress.addEventListener("change", onProgressChange);
  volume.addEventListener("input", onVolumeInput);

  playlistEl.addEventListener("click", onPlaylistClick);
  document.addEventListener("keydown", onKeyDown);
  addBtn.addEventListener("click", () => fileInput.click());
  fileInput.addEventListener("change", onFilesChosen);

  audio.addEventListener("loadedmetadata", onMetadataLoaded);
  audio.addEventListener("timeupdate", onTimeUpdate);
  audio.addEventListener("ended", onEnded);
  audio.addEventListener("waiting", onWaiting);
  audio.addEventListener("canplay", onCanPlay);
  audio.addEventListener("error", onError);
  audio.addEventListener("play", updatePlayButton);
  audio.addEventListener("pause", updatePlayButton);

  onVolumeInput();
  loadTrack(0);
  updatePlayButton();
}
init();
</script>
</body>
</html>